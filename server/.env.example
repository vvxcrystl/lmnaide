# Your custom hostname, without https://, a port, or a path.
# Point its DNS A/AAAA records at your server before starting Caddy.
CALENDAR_DOMAIN=calendar.domain.com

# Sign-in uses CrystlCloud Accounts. Register lmnaide on the accounts server:
#   npm run client -- add "lmnaide" https://calendar.domain.com/api/v1/oidc/callback --owner you@example.com
# then paste the client ID and secret it prints. See "Accounts" in README.md.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Set false to hide password sign-in once everyone has connected their account.
PASSWORD_LOGIN=true
# For another OpenID Connect issuer, set its URL and the name on the button.
# OIDC_ISSUER=https://accounts.crystlcloud.org/api/auth
# OIDC_NAME=CrystlCloud

# Or use only lmnaide's own email and password accounts:
# ACCOUNTS=local

# Set false to stop new accounts.
ALLOW_REGISTRATION=true
