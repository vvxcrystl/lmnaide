# Your custom hostname, without https://, a port, or a path.
# Point its DNS A/AAAA records at your server before starting Caddy.
CALENDAR_DOMAIN=calendar.domain.com
# Set false after creating the accounts you need.
ALLOW_REGISTRATION=true

# Accounts: "local" (lmnaide's own email and password accounts) or "oidc"
# (sign in through CrystlCloud Accounts or another OpenID Connect issuer).
# See "Accounts" in README.md.
ACCOUNTS=local
# For ACCOUNTS=oidc. Register https://<CALENDAR_DOMAIN>/api/v1/oidc/callback with the issuer.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Button label: "Continue with <OIDC_NAME>". Defaults to CrystlCloud.
OIDC_NAME=
# Set false to hide password sign-in once everyone has connected their account.
PASSWORD_LOGIN=true
