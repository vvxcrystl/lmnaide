<!-- White fading in toward the bottom; the widget tints it to its own background color.
     It stays faint for most of its height so rows dim gently rather than darken. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient android:angle="270" android:startColor="#00FFFFFF" android:centerColor="#40FFFFFF" android:centerY="0.55" android:endColor="#F2FFFFFF" />
</shape>
