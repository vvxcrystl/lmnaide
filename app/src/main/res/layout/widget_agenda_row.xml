<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="4dp" android:paddingBottom="4dp">
 <TextView android:id="@+id/widget_date" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginEnd="8dp" android:gravity="center" android:textSize="16sp" android:textColor="#EEEEEE"/>
 <LinearLayout android:id="@+id/widget_card" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/widget_card" android:padding="10dp" android:layout_marginTop="1dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
 <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="17sp" android:maxLines="2" android:ellipsize="end"/>
 <ImageView android:id="@+id/widget_importance" android:layout_width="18dp" android:layout_height="18dp" android:layout_marginStart="8dp" android:src="@drawable/widget_importance_low"/>
 </LinearLayout>
 <TextView android:id="@+id/widget_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:layout_marginTop="2dp"/>
 </LinearLayout>
</LinearLayout>