<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="2dp" android:paddingBottom="2dp">
 <TextView android:id="@+id/widget_date" android:layout_width="38dp" android:layout_height="38dp" android:layout_marginEnd="10dp" android:gravity="center" android:fontFamily="@font/google_sans_flex_family" android:textSize="14sp" android:lineSpacingMultiplier="0.9" android:textColor="#EEEEEE"/>
 <LinearLayout android:id="@+id/widget_card" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/widget_card" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="7dp" android:paddingBottom="7dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
 <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:fontFamily="@font/google_sans_flex_family" android:textSize="14sp" android:maxLines="2" android:ellipsize="end"/>
 <ImageView android:id="@+id/widget_importance" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginStart="8dp" android:src="@drawable/widget_importance_low"/>
 </LinearLayout>
 <TextView android:id="@+id/widget_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/google_sans_flex_family" android:textSize="14sp" android:layout_marginTop="1dp"/>
 </LinearLayout>
</LinearLayout>